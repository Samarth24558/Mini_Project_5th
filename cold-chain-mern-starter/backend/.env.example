PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional Gmail notifications; create an App Password after enabling 2-Step Verification.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
ALERT_FROM_EMAIL="ColdChain Ops <your-account@gmail.com>"
ADMIN_ALERT_EMAILS=admin@example.com
# Cold-chain thresholds (adjust for the product / cargo specification)
TEMP_MIN_C=2
TEMP_MAX_C=8
LOW_FUEL_THRESHOLD=15
DOOR_OPEN_THRESHOLD_SECONDS=300
SIMULATED_DOOR_OPEN_THRESHOLD_SECONDS=8

# Comma-separated Clerk user IDs that should have admin role. Configure before first sign-in.
ADMIN_CLERK_USER_IDS=user_3Lm5Djwr2qWTLGmknLcdxTJTdVd
API_RATE_LIMIT_PER_MINUTE=1000
